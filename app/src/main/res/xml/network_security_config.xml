<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Configuration for OnionRoute Lite
    
    On Android 9+ (API 28+), cleartext traffic is blocked by default.
    We need to allow connections to our local Tor proxy (127.0.0.1)
    since it uses cleartext SOCKS5/HTTP protocols.
    
    All external connections go through Tor, which handles its own
    encryption. This config does NOT weaken the app's security —
    it only allows local loopback connections.
-->
<network-security-config>
    <!-- Allow cleartext to localhost only (for Tor SOCKS5/HTTP proxy) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    
    <!-- All other domains: cleartext NOT permitted (default) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
