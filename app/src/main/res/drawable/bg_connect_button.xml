<?xml version="1.0" encoding="utf-8"?>
<!-- Connect button — large circle with state-based background -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#FF0D3B12" />
            <stroke
                android:width="3dp"
                android:color="#FF4CAF50" />
        </shape>
    </item>
    <!-- Default state (disconnected) -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/bg_connect_off" />
            <stroke
                android:width="3dp"
                android:color="#FF4CAF50" />
        </shape>
    </item>
</selector>
