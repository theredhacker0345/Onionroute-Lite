<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- OnionRoute Theme — OLED black, no action bar, edge-to-edge for Compose -->
    <style name="Theme.OnionRouteLite" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>
    </style>

    <!-- Switch theme with Jade accent for XML-based switches -->
    <style name="SwitchTheme" parent="android:Theme.DeviceDefault">
        <item name="android:colorForeground">@color/jade_accent</item>
    </style>
</resources>
