# ══════════════════════════════════════════════════════════════
# OnionRoute Lite — .gitignore
# ══════════════════════════════════════════════════════════════

# ── Android ──────────────────────────────────────────────────
*.apk
*.ap_
*.aab
*.dex
*.class
*.jar
!gradle-wrapper.jar

# ── Build Outputs ────────────────────────────────────────────
/build/
/app/build/
/out/
/release/
/debug/

# ── Gradle ───────────────────────────────────────────────────
.gradle/
local.properties
.gradletasknamecache

# ── IDE ──────────────────────────────────────────────────────
.idea/
*.iml
*.iws
*.ipr
.DS_Store

# ── Native Build Artifacts ──────────────────────────────────
# The actual .so files should NOT be committed to git.
# They should be built from source during CI/F-Droid build.
/app/src/main/jniLibs/**/*.so

# Native build working directory (sources downloaded + compiled)
/build-native/

# ── Keystore (NEVER commit release keystores) ────────────────
# Debug keystore is committed for F-Droid reproducible builds
*.jks
*.keystore
!app/debug.keystore

# ── Environment & Secrets ────────────────────────────────────
.env
.env.*

# ── Development / CI Artifacts ───────────────────────────────
/download/
/upload/
/latest/
/skills/
/worklog*.md
/build_manual/
/apk-extracted/
/audit/
androguard.db
androguard.log

# ── Stray Root Files ─────────────────────────────────────────
# ProGuard rules belong in app/proguard-rules.pro, not root
/proguard-rules.pro
# Launcher icons belong in app/src/main/res/, not root
/ic_launcher.png

# ── Node.js (used by CI tooling only) ───────────────────────
node_modules/
package.json
package-lock.json

# ── Temp Files ───────────────────────────────────────────────
*.log
*.tmp
*.swp
*~

# ── OS Files ─────────────────────────────────────────────────
Thumbs.db
Desktop.ini
*.gguf
ci-results/
