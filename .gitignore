# ══════════════════════════════════════════════════════════════
# OnionRoute Lite — .gitignore
# ══════════════════════════════════════════════════════════════

# ── Android ──────────────────────────────────────────────────
*.apk
*.ap_
*.aab
*.dex
*.class
*.jar
!gradle-wrapper.jar

# ── Build Outputs ────────────────────────────────────────────
/build/
/app/build/
/out/
/release/
/debug/

# ── Gradle ───────────────────────────────────────────────────
.gradle/
local.properties
.gradletasknamecache

# ── IDE ──────────────────────────────────────────────────────
.idea/
*.iml
*.iws
*.ipr
.DS_Store

# ── Native Build Artifacts ──────────────────────────────────
# The actual .so files should NOT be committed to git.
# They should be built from source during CI/F-Droid build.
/app/src/main/jniLibs/**/*.so

# Native build working directory (sources downloaded + compiled)
/build-native/

# ── Keystore (NEVER commit release keystores) ────────────────
# Debug keystore is committed for F-Droid reproducible builds
*.jks
*.keystore
!app/debug.keystore

# ── Manual Build Artifacts ──────────────────────────────────
/build_manual/

# ── Analysis / Testing Artifacts ────────────────────────────
/apk-extracted/
node_modules/
package.json
package-lock.json
captcha-*
signup-*.png
solve-captcha.js
test-apk.js
upload-apk.js
appetize-signup*.js
complete-signup.js
final-signup*.js

# ── Legacy / Deleted Packages ───────────────────────────────
# These were deleted for F-Droid compliance (Google STUN refs)
/app/src/main/java/org/torlite/
/app/src/main/java/org/phantomvpn/
/metadata/org.torlite.yml

# ── Temp Files ───────────────────────────────────────────────
*.log
*.tmp
*.swp
*~

# ── OS Files ─────────────────────────────────────────────────
Thumbs.db
Desktop.ini
